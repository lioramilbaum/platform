{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>lioramilbaum/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/lib\\.sh$/"],
      "matchStrings": [
        "export KIND_VERSION=\"\\$\\{KIND_VERSION:-(?<currentValue>v[0-9.]+)\\}\""
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    }
  ]
}
