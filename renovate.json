{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "separateMajorMinor": false,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^component-constructor\\.yaml$", "^scripts/bootstrap\\.sh$"],
      "matchStrings": [
        "name: ocm\\n\\s+type: executable\\n\\s+version: (?<currentValue>v[0-9.]+)",
        "OCM_BOOTSTRAP_VERSION=\"(?<currentValue>v[0-9.]+)\""
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^component-constructor\\.yaml$"],
      "matchStrings": [
        "name: kind\\n\\s+type: executable\\n\\s+version: (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    }
  ]
}
